{
  "name": "swift-aws-lambda-example",
  "version": "0.1.0",
  "bin": {
    "swift-aws-lambda-example": "bin/swift-aws-lambda-example.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build --clean && tsc",
    "clean": "tsc --build --clean",
    "watch": "tsc -w",
    "test": "vitest run --passWithNoTests",
    "cdk": "cdk",
    "lint": "oxlint .",
    "lint-fix": "oxlint --fix ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.92.0",
    "oxlint-plugin-awscdk": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
